
import os
import zipfile
import time
import gc
from pathlib import PurePosixPath, PureWindowsPath
from tqdm.auto import tqdm


# ============================================================
# CONFIGURATION
# ============================================================

ZIP_FILE = (
    "/content/drive/MyDrive/"
    "Filee.zip"
)

OUTPUT_DIR = "/content/drive/MyDrive/One Piece"

CHUNK_SIZE = 16 * 1024 * 1024  # 16 MB

# Cleanup settings
UNMOUNT_DRIVE_AFTER_SUCCESS = True

# Set True to disconnect and release the Colab runtime
# automatically after successful extraction.
SHUTDOWN_RUNTIME_AFTER_SUCCESS = False


# ============================================================
# HELPER FUNCTIONS
# ============================================================

def format_size(size_bytes):
    """Convert bytes into a readable size."""

    if size_bytes >= 1024 ** 3:
        return f"{size_bytes / (1024 ** 3):.2f} GB"

    elif size_bytes >= 1024 ** 2:
        return f"{size_bytes / (1024 ** 2):.2f} MB"

    elif size_bytes >= 1024:
        return f"{size_bytes / 1024:.2f} KB"

    return f"{size_bytes} B"


def print_header(title):
    """Print a formatted section heading."""

    print("\n" + "=" * 80)
    print(title.center(80))
    print("=" * 80)


def safe_output_path(base_dir, member_name):
    """
    Prevent ZIP entries from writing outside OUTPUT_DIR.
    Handles both Unix-style and Windows-style ZIP paths.
    """

    normalized_name = member_name.replace("\\", "/")

    posix_path = PurePosixPath(normalized_name)
    windows_path = PureWindowsPath(member_name)

    if (
        posix_path.is_absolute()
        or windows_path.is_absolute()
        or windows_path.drive
        or ".." in posix_path.parts
        or not posix_path.parts
    ):
        raise ValueError("Unsafe ZIP entry path")

    base_real = os.path.realpath(base_dir)

    destination = os.path.realpath(
        os.path.join(base_real, *posix_path.parts)
    )

    if os.path.commonpath([base_real, destination]) != base_real:
        raise ValueError("ZIP entry attempts to leave the output directory")

    return destination


def parse_file_selection(selection, total_files):
    """
    Accepts:
        1,3,7
        1-5
        1,3-5,8
    """

    selected_numbers = []

    for item in selection.split(","):

        item = item.strip()

        if not item:
            continue

        try:
            if "-" in item:

                start, end = map(int, item.split("-", 1))

                if start > end:
                    print(f"⚠️ Ignoring invalid range: {item}")
                    continue

                selected_numbers.extend(range(start, end + 1))

            else:
                selected_numbers.append(int(item))

        except ValueError:
            print(f"⚠️ Ignoring invalid input: {item}")

    # Remove duplicate selections while preserving order
    unique_numbers = list(dict.fromkeys(selected_numbers))

    valid_numbers = []

    for number in unique_numbers:

        if 1 <= number <= total_files:
            valid_numbers.append(number)

        else:
            print(f"⚠️ Ignoring invalid file number: {number}")

    return valid_numbers


# ============================================================
# MAIN EXTRACTION FUNCTION
# ============================================================

def run_extraction():

    # --------------------------------------------------------
    # CHECK ZIP FILE
    # --------------------------------------------------------

    if not os.path.isfile(ZIP_FILE):

        raise FileNotFoundError(
            f"\nZIP file not found:\n{ZIP_FILE}\n\n"
            "Please check the ZIP_FILE path."
        )

    zip_file_size = os.path.getsize(ZIP_FILE)

    print_header("📦 ZIP FILE INFORMATION")

    print(f"📄 ZIP file   : {ZIP_FILE}")
    print(f"💾 ZIP size   : {format_size(zip_file_size)}")
    print(f"📂 Output     : {OUTPUT_DIR}")
    print(f"⚡ Chunk size : {format_size(CHUNK_SIZE)}")

    # --------------------------------------------------------
    # READ ZIP CONTENTS
    # --------------------------------------------------------

    print_header("📦 READING ZIP CONTENTS")

    with zipfile.ZipFile(ZIP_FILE, "r") as zip_ref:

        all_files = [
            item for item in zip_ref.infolist()
            if not item.is_dir()
        ]

    if not all_files:

        print("❌ The ZIP archive contains no files.")
        return False

    total_uncompressed_size = sum(
        item.file_size for item in all_files
    )

    # --------------------------------------------------------
    # DISPLAY ZIP CONTENTS
    # --------------------------------------------------------

    print_header("📋 FILES INSIDE ZIP")

    running_total = 0

    for index, info in enumerate(all_files, 1):

        running_total += info.file_size

        print(
            f"[{index:3}] {info.filename}"
            f" | Size: {format_size(info.file_size)}"
            f" | Total: {format_size(running_total)}"
        )

    print("-" * 80)

    print(f"📦 Total files       : {len(all_files)}")
    print(f"💾 Uncompressed size : {format_size(total_uncompressed_size)}")
    print(f"🗜️ ZIP file size     : {format_size(zip_file_size)}")

    # --------------------------------------------------------
    # EXTRACTION OPTIONS
    # --------------------------------------------------------

    print_header("🎯 EXTRACTION OPTIONS")

    print("1. 📦 Extract the entire ZIP file")
    print("2. 🎯 Extract selected files")

    while True:

        extraction_mode = input(
            "\nSelect extraction option (1 or 2): "
        ).strip()

        if extraction_mode in ("1", "2"):
            break

        print("⚠️ Please enter either 1 or 2.")

    # --------------------------------------------------------
    # SELECT FILES
    # --------------------------------------------------------

    if extraction_mode == "1":

        selected_files = all_files.copy()

        print_header("📦 ENTIRE ZIP SELECTED")

    else:

        selection = input(
            "\nEnter file numbers or ranges "
            "(Example: 1,3,7 or 1-5): "
        )

        selected_numbers = parse_file_selection(
            selection,
            len(all_files)
        )

        selected_files = [
            all_files[number - 1]
            for number in selected_numbers
        ]

    # --------------------------------------------------------
    # VALIDATE SELECTED FILE PATHS
    # --------------------------------------------------------

    output_base = os.path.realpath(
        os.path.abspath(OUTPUT_DIR)
    )

    prepared_files = []

    print_header("🔍 VALIDATING SELECTED FILES")

    for info in selected_files:

        try:

            output_path = safe_output_path(
                output_base,
                info.filename
            )

            prepared_files.append((info, output_path))

        except ValueError:

            print(
                f"⚠️ Skipping unsafe ZIP entry: "
                f"{info.filename}"
            )

    selected_files = prepared_files

    if not selected_files:

        print("\n❌ No valid files selected.")
        print("⚠️ Extraction cancelled.")

        return False

    # --------------------------------------------------------
    # SELECTION SUMMARY
    # --------------------------------------------------------

    total_selected_size = sum(
        info.file_size for info, _ in selected_files
    )

    print_header("🎯 EXTRACTION SUMMARY")

    for index, (info, _) in enumerate(selected_files, 1):

        print(
            f"[{index:3}] 📄 {info.filename}"
            f" | {format_size(info.file_size)}"
        )

    print("-" * 80)

    print(f"📦 Files selected : {len(selected_files)}")
    print(f"💾 Total size     : {format_size(total_selected_size)}")

    print_header("🚀 STARTING EXTRACTION")

    os.makedirs(output_base, exist_ok=True)

    overall_start = time.perf_counter()
    extracted_count = 0

    # --------------------------------------------------------
    # OPEN ZIP FILE
    # --------------------------------------------------------

    with zipfile.ZipFile(ZIP_FILE, "r") as zip_ref:

        # ----------------------------------------------------
        # OVERALL PROGRESS BAR
        # ----------------------------------------------------

        with tqdm(
            total=total_selected_size,
            desc="📊 Overall progress",
            unit="B",
            unit_scale=True,
            unit_divisor=1024,
            position=0,
            dynamic_ncols=True,
            colour="green"
        ) as overall_progress:

            for index, (info, output_path) in enumerate(
                selected_files, 1
            ):

                parent_directory = os.path.dirname(output_path)

                os.makedirs(
                    parent_directory,
                    exist_ok=True
                )

                # Temporary file prevents incomplete output
                temp_path = output_path + ".part"

                print("\n" + "─" * 80)

                print(
                    f"🚀 EXTRACTING FILE "
                    f"{index}/{len(selected_files)}"
                )

                print(f"📄 File : {info.filename}")
                print(f"💾 Size : {format_size(info.file_size)}")

                print("─" * 80)

                file_start = time.perf_counter()
                bytes_written = 0

                try:

                    # ----------------------------------------
                    # CHUNK-BASED EXTRACTION
                    # ----------------------------------------

                    with zip_ref.open(info, "r") as source:

                        with open(temp_path, "wb") as target:

                            with tqdm(
                                total=info.file_size,
                                desc="⚡ Current file",
                                unit="B",
                                unit_scale=True,
                                unit_divisor=1024,
                                position=1,
                                leave=False,
                                dynamic_ncols=True,
                                colour="cyan"
                            ) as file_progress:

                                while True:

                                    chunk = source.read(CHUNK_SIZE)

                                    if not chunk:
                                        break

                                    target.write(chunk)

                                    chunk_size = len(chunk)
                                    bytes_written += chunk_size

                                    file_progress.update(chunk_size)
                                    overall_progress.update(chunk_size)

                    # ----------------------------------------
                    # COMPLETE FILE
                    # ----------------------------------------

                    os.replace(temp_path, output_path)

                    extracted_count += 1

                except Exception:

                    # Remove incomplete temporary file
                    if os.path.exists(temp_path):
                        os.remove(temp_path)

                    raise

                # ------------------------------------------------
                # FILE EXTRACTION STATISTICS
                # ------------------------------------------------

                elapsed = time.perf_counter() - file_start

                speed = (
                    bytes_written / elapsed / (1024 ** 2)
                    if elapsed > 0 else 0
                )

                print(
                    f"✅ Completed: {info.filename}"
                )

                print(
                    f"⚡ Speed   : {speed:.2f} MB/s"
                )

                print(
                    f"⏱️ Time    : {elapsed / 60:.2f} minutes"
                )

    # --------------------------------------------------------
    # FINAL SUMMARY
    # --------------------------------------------------------

    total_time = time.perf_counter() - overall_start

    print_header("🎉 EXTRACTION COMPLETED SUCCESSFULLY!")

    print(f"📦 Files extracted : {extracted_count}")
    print(f"💾 Total data      : {format_size(total_selected_size)}")
    print(f"⏱️ Total time      : {total_time / 60:.2f} minutes")
    print(f"📂 Output location : {OUTPUT_DIR}")

    print("=" * 80)

    return True


# ============================================================
# RUN EXTRACTION AND CLEAN UP COLAB RESOURCES
# ============================================================

extraction_successful = False

try:

    extraction_successful = run_extraction()

except KeyboardInterrupt:

    print("\n\n⚠️ Extraction interrupted by user.")

except Exception as error:

    print("\n\n❌ EXTRACTION FAILED")
    print(f"Error: {error}")

finally:

    # --------------------------------------------------------
    # CLEAR PYTHON MEMORY
    # --------------------------------------------------------

    print_header("🧹 CLEANING UP COLAB RESOURCES")

    print("♻️ Running garbage collection...")

    gc.collect()

    print("✅ Python garbage collection completed.")

    # --------------------------------------------------------
    # FLUSH AND UNMOUNT GOOGLE DRIVE
    # --------------------------------------------------------

    if extraction_successful and UNMOUNT_DRIVE_AFTER_SUCCESS:

        try:

            from google.colab import drive

            print("\n💾 Flushing Google Drive changes...")
            drive.flush_and_unmount()

            print("✅ Google Drive flushed and unmounted.")

        except Exception as error:

            print(
                f"⚠️ Could not unmount Google Drive: {error}"
            )

    # --------------------------------------------------------
    # OPTIONAL: SHUT DOWN COLAB RUNTIME
    # --------------------------------------------------------

    if extraction_successful and SHUTDOWN_RUNTIME_AFTER_SUCCESS:

        try:

            print("\n🔌 Disconnecting Google Colab runtime...")

            from google.colab import runtime

            runtime.unassign()

        except Exception as error:

            print(
                f"⚠️ Runtime shutdown could not be completed: "
                f"{error}"
            )

    elif extraction_successful:

        print(
            "\n✅ Cleanup completed. "
            "Colab runtime is still active."
        )

        print(
            "To release the complete runtime, use "
            "Runtime → Disconnect and delete runtime."
        )

    else:

        print(
            "\n⚠️ Extraction did not complete successfully. "
            "The runtime has not been automatically shut down."
        )

    print("\n🏁 PROCESS FINISHED.")
